# PIL environment variables
# Copy to .env and fill in values:  cp .env.example .env && chmod 600 .env

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=pil
POSTGRES_USER=pil
POSTGRES_PASSWORD=change_me_postgres

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis

# ── Neo4j ────────────────────────────────────────────────────────────────────
# Used as NEO4J_AUTH=neo4j/<password>
NEO4J_PASSWORD=change_me_neo4j

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_API_KEY=change_me_qdrant_key

# ── Telegram Business Bot ────────────────────────────────────────────────────
# Токен из @BotFather (Business Mode должен быть включён в настройках бота)
BOT_TOKEN=change_me_bot_token
WEBHOOK_BASE_URL=https://pil.yourdomain.com
WEBHOOK_SECRET=change_me_webhook_secret
# Прокси до Telegram (compose по умолчанию: http://xray:8080). Альтернатива: socks5://xray:10808
# Прокси до Telegram: обычно http://xray:8080; при проблемах с CONNECT попробуй socks5://xray:10808
TG_PROXY_URL=http://xray:8080
# Таймаут HTTP-запросов к Bot API (сек), при медленном VLESS/Reality подними до 180
TG_API_TIMEOUT_SECONDS=120

# ── S3 cloud.ru (boto3-compatible) ───────────────────────────────────────────
S3_ENDPOINT_URL=https://s3.cloud.ru
S3_BUCKET_RAW=pil-raw
S3_BUCKET_MEDIA=pil-raw-media
S3_BUCKET_BACKUPS=pil-backups
S3_ACCESS_KEY_ID=change_me_s3_key_id
S3_SECRET_ACCESS_KEY=change_me_s3_secret
S3_REGION=ru-central-1

# Admin surface publishing
# Default: loopback-only on the server.
# For LAN access, for example:
# ADMIN_BIND_HOST=192.168.31.165
# ADMIN_PUBLISHED_PORT=80
ADMIN_BIND_HOST=127.0.0.1
ADMIN_PUBLISHED_PORT=8090

# Canonical AI analysis behavior
ANALYSIS_OUTPUT_LANGUAGE=ru

# Owner identity normalization
# Use these values so PIL can reliably recognize the profile owner in tasks,
# summaries, analytics, and relationship projection.
OWNER_TG_USER_IDS=
OWNER_USERNAMES=
OWNER_DISPLAY_NAMES=
OWNER_PRIMARY_DISPLAY_NAME=
